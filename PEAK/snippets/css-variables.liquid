{% style %}
  @font-face {
    font-family: 'Pitviper';
    src: url('{{ "Pitviper.ttf" | asset_url }}') format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Pitviper';
    src: url('{{ "Pitviper-Italic.ttf" | asset_url }}') format('truetype');
    font-weight: normal;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: 'Pitviper Extended';
    src: url('{{ "PitviperExtended.ttf" | asset_url }}') format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Pitviper Extended';
    src: url('{{ "PitviperExtended-Italic.ttf" | asset_url }}') format('truetype');
    font-weight: normal;
    font-style: italic;
    font-display: swap;
  }

  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-primary--family: 'Pitviper', {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --font-extended: 'Pitviper Extended', sans-serif;
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: #000000;
    --color-foreground: #FFFFFF;
    --color-accent: #EFFF04;
    --color-accent-red: #FF002F;
    --color-border: #333333;
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
  }
{% endstyle %}
