{% style %}
  :root {
    --font-primary--family: 'Spline Sans Mono', monospace;
    --font-primary--style: normal;
    --font-primary--weight: 400;
    --font-extended: 'Staatliches', sans-serif;
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: #000000;
    --color-foreground: #FFFFFF;
    --color-accent: #EFFF04;
    --color-accent-red: #FF002F;
    --color-border: #333333;
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
  }
{% endstyle %}
