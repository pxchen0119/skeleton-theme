<header class="site-header">
  <div class="header__container">
    <div class="header__logo">
      <a href="{{ routes.root_url }}">
        <h1>{{ shop.name }}</h1>
      </a>
    </div>

    <nav class="header__menu">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="header__menu-link">{{ link.title }}</a>
      {% endfor %}
    </nav>

    <div class="header__icons">
      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}" class="header__account">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="header__cart">
        {% if cart.item_count > 0 %}
          <span class="cart-count">{{ cart.item_count }}</span>
        {% endif %}
        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
  }

  .header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 0;
    gap: 2rem;
  }

  .header__logo h1 {
    font-family: var(--font-extended);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    margin: 0;
    letter-spacing: 0.15em;
  }

  .header__logo a {
    color: var(--color-foreground);
  }

  .header__logo a:hover {
    color: var(--color-accent);
  }

  .header__menu {
    display: flex;
    gap: 2rem;
    align-items: center;
    flex: 1;
    justify-content: center;
  }

  .header__menu-link {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    position: relative;
    padding: 0.5rem 0;
  }

  .header__menu-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-accent);
    transition: width 0.3s ease;
  }

  .header__menu-link:hover::after {
    width: 100%;
  }

  .header__icons {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .header__cart,
  .header__account {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .header__cart svg,
  .header__account svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: currentColor;
  }

  .cart-count {
    position: absolute;
    top: -8px;
    right: -8px;
    background-color: var(--color-accent-red);
    color: var(--color-foreground);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.4rem;
    border-radius: 50%;
    min-width: 1.2rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    .header__menu {
      display: none;
    }

    .header__container {
      padding: 1rem 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
