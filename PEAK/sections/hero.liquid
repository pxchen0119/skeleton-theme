<div class="hero-section full-width" style="--hero-height: {{ section.settings.height }}vh">
  {% if section.settings.video_url != blank or section.settings.video_file != blank %}
    <div class="hero__background hero__background--video">
      <video
        class="hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        {% if section.settings.background_image %}
          poster="{{ section.settings.background_image | image_url: width: 2000 }}"
        {% endif %}
      >
        {% if section.settings.video_url != blank %}
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        {% else %}
          <source src="{{ section.settings.video_file | file_url }}" type="video/mp4">
        {% endif %}
      </video>
    </div>
  {% elsif section.settings.background_image %}
    <div class="hero__background">
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: loading: 'eager' }}
    </div>
  {% endif %}

  <div class="hero__overlay" style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>

  <div class="hero__content">
    {% if section.settings.heading != blank %}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="hero__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="hero__signup">
        <input
          class="hero__email-input"
          type="email"
          name="contact[email]"
          placeholder="enter@your.email"
          required
          aria-label="Email address"
        >
        <button type="submit" class="hero__button button">
          {% if section.settings.button_text != blank %}
            {{ section.settings.button_text }}
          {% else %}
            Sign Up
          {% endif %}
        </button>
      </div>
      {%- if form.errors -%}
        <p class="hero__form-message hero__form-message--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      {%- if form.posted_successfully? -%}
        <p class="hero__form-message hero__form-message--success">Thanks for signing up!</p>
      {%- endif -%}
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .hero-section {
    position: relative;
    width: 100%;
    min-height: var(--hero-height);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero__background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    background-color: #1a1a1a;
  }

  .hero__background img,
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero__background--video {
    overflow: hidden;
  }

  .hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--color-background);
    opacity: var(--overlay-opacity);
    z-index: 1;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 800px;
    padding: 2rem;
  }

  .hero__heading {
    font-size: clamp(2rem, 6vw, 4.5rem);
    margin-bottom: 1rem;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .hero__subheading {
    font-size: clamp(1rem, 2vw, 1.5rem);
    margin-bottom: 2rem;
    opacity: 0.9;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero__signup {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    margin-top: 1rem;
    width: 320px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero__signup:hover .hero__email-input {
    background-color: rgba(255, 255, 255, 0.25);
  }

  .hero__email-input {
    padding: 1.25rem 1.5rem;
    font-size: 1rem;
    border: none;
    background-color: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    outline: none;
    width: 100%;
    font-family: var(--font-primary--family);
    letter-spacing: 0.05em;
    /* transition: background-color 0.2s ease; */
    box-sizing: border-box;
  }

  .hero__email-input::placeholder {
    color: rgba(255, 255, 255, 0.6);
  }

  .hero__email-input:focus {
    background-color: rgba(255, 255, 255, 0.25);
  }

  .hero__form-message {
    margin-top: 0.75rem;
    font-size: 0.9rem;
  }

  .hero__form-message--error {
    color: #ff6b6b;
  }

  .hero__form-message--success {
    color: #a8e6a3;
  }

  .hero__button {
    display: block;
    width: 100%;
    margin-top: 0;
    padding: 1.25rem 3rem;
    font-size: 1rem;
    background-color: rgba(139, 0, 0, 0.7);
    color: #ffffff;
    box-sizing: border-box;
    text-align: center;
  }

  .hero__button:hover {
    background-color: rgba(78, 37, 37, 0.7);
    box-shadow: inset 0 0 0 2px rgba(78, 37, 37, 0.7);
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .hero-section {
      min-height: 70vh;
    }

    .hero__content {
      padding: 1.5rem;
    }

    .hero__signup {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hero.name",
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Welcome to Peak"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Premium performance nutrition"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:labels.button_text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "header",
      "content": "t:general.design"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL",
      "info": "External video URL (e.g., from CDN). This takes priority over the uploaded video file."
    },
    {
      "type": "video",
      "id": "video_file",
      "label": "t:labels.background_video",
      "info": "t:info.background_video"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image",
      "info": "t:info.background_image_fallback"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:labels.overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "height",
      "label": "t:labels.section_height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 90
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name"
    }
  ]
}
{% endschema %}
