<div class="hero-section full-width" style="--hero-height: {{ section.settings.height }}vh">
  {% if section.settings.video_file != blank %}
    <div class="hero__background hero__background--video">
      <video
        class="hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        {% if section.settings.background_image %}
          poster="{{ section.settings.background_image | image_url: width: 2000 }}"
        {% endif %}
      >
        <source src="{{ section.settings.video_file | file_url }}" type="video/mp4">
      </video>
    </div>
  {% elsif section.settings.background_image %}
    <div class="hero__background">
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: loading: 'eager' }}
    </div>
  {% endif %}

  <div class="hero__overlay" style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>

  <div class="hero__content">
    {% if section.settings.heading != blank %}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="hero__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_link }}" class="hero__button button">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .hero-section {
    position: relative;
    width: 100%;
    min-height: var(--hero-height);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero__background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    background-color: #1a1a1a;
  }

  .hero__background img,
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero__background--video {
    overflow: hidden;
  }

  .hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--color-background);
    opacity: var(--overlay-opacity);
    z-index: 1;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 800px;
    padding: 2rem;
  }

  .hero__heading {
    font-size: clamp(2rem, 6vw, 4.5rem);
    margin-bottom: 1rem;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .hero__subheading {
    font-size: clamp(1rem, 2vw, 1.5rem);
    margin-bottom: 2rem;
    opacity: 0.9;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero__button {
    display: inline-block;
    margin-top: 1rem;
    padding: 1.25rem 3rem;
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .hero-section {
      min-height: 70vh;
    }

    .hero__content {
      padding: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hero.name",
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Welcome to Peak"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Premium performance nutrition"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:labels.button_text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "header",
      "content": "t:general.design"
    },
    {
      "type": "video",
      "id": "video_file",
      "label": "t:labels.background_video",
      "info": "t:info.background_video"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image",
      "info": "t:info.background_image_fallback"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:labels.overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "height",
      "label": "t:labels.section_height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 90
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name"
    }
  ]
}
{% endschema %}
