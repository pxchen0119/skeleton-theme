<div class="product-grid-section">
  {% if section.settings.heading != blank %}
    <h2 class="product-grid__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {% if section.settings.description != blank %}
    <p class="product-grid__description">{{ section.settings.description }}</p>
  {% endif %}

  <div class="product-grid" style="--columns: {{ section.settings.columns_desktop }}; --columns-mobile: {{ section.settings.columns_mobile }}">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .product-grid-section {
    padding: 4rem 0;
  }

  .product-grid__heading {
    font-size: clamp(2rem, 5vw, 4rem);
    text-align: center;
    margin-bottom: 1rem;
    color: var(--color-foreground);
  }

  .product-grid__description {
    text-align: center;
    margin-bottom: 3rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    font-size: 1.1rem;
    opacity: 0.8;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }

  @media (max-width: 768px) {
    .product-grid {
      grid-template-columns: repeat(var(--columns-mobile), 1fr);
      gap: 1.5rem;
    }

    .product-grid-section {
      padding: 2rem 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_grid.name",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Featured Products"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:labels.columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_grid.name"
    }
  ]
}
{% endschema %}
