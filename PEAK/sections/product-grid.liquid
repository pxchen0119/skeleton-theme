<div class="product-grid-section">
  {% if section.settings.heading != blank %}
    <h2 class="product-grid__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {% if section.settings.description != blank %}
    <p class="product-grid__description">{{ section.settings.description }}</p>
  {% endif %}

  <div class="carousel-container">
    <div class="carousel-3d">
      <div class="product-grid">
        {% content_for 'blocks' %}
      </div>
    </div>
    <button class="carousel-nav carousel-nav--prev" aria-label="Previous product">‹</button>
    <button class="carousel-nav carousel-nav--next" aria-label="Next product">›</button>
  </div>
</div>

{% stylesheet %}
  .product-grid-section {
    padding: 4rem 0;
  }

  .product-grid__heading {
    font-size: clamp(2rem, 5vw, 4rem);
    text-align: center;
    margin-bottom: 1rem;
    color: var(--color-foreground);
  }

  .product-grid__description {
    text-align: center;
    margin-bottom: 3rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    font-size: 1.1rem;
    opacity: 0.8;
  }

  .carousel-container {
    position: relative;
    width: 100%;
    height: 600px;
    margin-top: 2rem;
    overflow: hidden;
  }

  .carousel-3d {
    position: relative;
    width: 100%;
    height: 100%;
    perspective: 2000px;
    perspective-origin: 50% 50%;
  }

  .product-grid {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .product-grid > * {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 350px;
    margin-left: -185px;
    margin-top: -230px;
    transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    backface-visibility: hidden;
  }

  .carousel-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: var(--color-accent);
    color: var(--color-background);
    border: none;
    width: 50px;
    height: 50px;
    font-size: 2rem;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s ease;
    font-weight: bold;
    line-height: 1;
    padding: 0;
  }

  .carousel-nav:hover {
    background-color: var(--color-foreground);
    transform: translateY(-50%) scale(1.1);
  }

  .carousel-nav--prev {
    left: 20px;
  }

  .carousel-nav--next {
    right: 20px;
  }

  @media (max-width: 768px) {
    .carousel-container {
      height: 700px;
    }

    .product-grid > * {
      width: 280px;
      margin-left: -140px;
      margin-top: -160px;
    }

    .carousel-nav {
      width: 40px;
      height: 40px;
      font-size: 1.5rem;
    }

    .carousel-nav--prev {
      left: 10px;
    }

    .carousel-nav--next {
      right: 10px;
    }

    .product-grid-section {
      padding: 2rem 0;
    }
  }
{% endstylesheet %}

{% javascript %}
  class Carousel3D {
    constructor(container) {
      this.container = container;
      this.carousel = container.querySelector('.product-grid');
      this.items = Array.from(this.carousel.children);
      this.currentIndex = 0;
      this.isAnimating = false;

      if (this.items.length === 0) return;

      this.radius = 400;
      this.theta = (2 * Math.PI) / this.items.length;

      this.prevBtn = container.querySelector('.carousel-nav--prev');
      this.nextBtn = container.querySelector('.carousel-nav--next');

      this.touchStartX = 0;
      this.touchEndX = 0;
      this.wheelTimeout = null;

      this.init();
    }

    init() {
      this.positionItems();
      this.attachEvents();
      this.startAutoRotate();
    }

    positionItems() {
      this.items.forEach((item, index) => {
        const angle = this.theta * (index - this.currentIndex);
        const x = Math.sin(angle) * this.radius;
        const z = Math.cos(angle) * this.radius;

        const scale = (z + this.radius) / (this.radius * 2);
        const opacity = scale;
        const zIndex = Math.round(scale * 100);

        item.style.transform = `translateX(${x}px) translateZ(${z}px)`;
        item.style.opacity = opacity;
        item.style.zIndex = zIndex;
      });
    }

    rotate(direction) {
      if (this.isAnimating) return;

      this.isAnimating = true;

      if (direction === 'next') {
        this.currentIndex = (this.currentIndex + 1) % this.items.length;
      } else {
        this.currentIndex = (this.currentIndex - 1 + this.items.length) % this.items.length;
      }

      this.positionItems();

      setTimeout(() => {
        this.isAnimating = false;
      }, 600);
    }

    handleTouchStart(e) {
      this.touchStartX = e.changedTouches[0].screenX;
    }

    handleTouchEnd(e) {
      this.touchEndX = e.changedTouches[0].screenX;
      this.handleSwipe();
    }

    handleSwipe() {
      const swipeThreshold = 50;
      const diff = this.touchStartX - this.touchEndX;

      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0) {
          this.rotate('next');
        } else {
          this.rotate('prev');
        }
        this.stopAutoRotate();
      }
    }

    handleWheel(e) {
      if (Math.abs(e.deltaX) < 5) return;

      e.preventDefault();

      clearTimeout(this.wheelTimeout);

      this.wheelTimeout = setTimeout(() => {
        if (e.deltaX > 0) {
          this.rotate('next');
        } else if (e.deltaX < 0) {
          this.rotate('prev');
        }
        this.stopAutoRotate();
      }, 10);
    }

    attachEvents() {
      this.prevBtn?.addEventListener('click', () => {
        this.rotate('prev');
        this.stopAutoRotate();
      });

      this.nextBtn?.addEventListener('click', () => {
        this.rotate('next');
        this.stopAutoRotate();
      });

      this.container.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          this.rotate('prev');
          this.stopAutoRotate();
        }
        if (e.key === 'ArrowRight') {
          this.rotate('next');
          this.stopAutoRotate();
        }
      });

      this.container.addEventListener('touchstart', (e) => this.handleTouchStart(e), { passive: true });
      this.container.addEventListener('touchend', (e) => this.handleTouchEnd(e), { passive: true });
      this.container.addEventListener('wheel', (e) => this.handleWheel(e), { passive: false });
    }

    startAutoRotate() {
      this.autoRotateInterval = setInterval(() => {
        this.rotate('next');
      }, 4000);
    }

    stopAutoRotate() {
      clearInterval(this.autoRotateInterval);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const carousels = document.querySelectorAll('.carousel-container');
    carousels.forEach(container => new Carousel3D(container));
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.product_grid.name",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Featured Products"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:labels.columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_grid.name"
    }
  ]
}
{% endschema %}
